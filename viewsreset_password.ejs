<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>កំណត់លេខសម្ងាត់ថ្មី</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white p-8 rounded-3xl shadow-xl max-w-md w-full border text-center">
        <h2 class="text-2xl font-bold text-gray-800 mb-2">កំណត់លេខសម្ងាត់ថ្មី</h2>
        <p class="text-xs text-gray-500 mb-6">សូមវាយបញ្ចូលលេខសម្ងាត់ថ្មីរបស់អ្នក</p>

        <div id="alert" class="hidden text-xs p-3 rounded-xl mb-4"></div>

        <form id="reset-form" class="space-y-4">
            <div class="text-left">
                <label class="block text-xs font-bold text-gray-700 mb-1">លេខសម្ងាត់ថ្មី</label>
                <input type="password" id="new-password" required placeholder="••••••••" 
                       class="w-full px-4 py-2.5 bg-gray-50 border rounded-xl text-sm focus:outline-none focus:border-emerald-500">
            </div>
            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl transition">
                រក្សាទុកលេខសម្ងាត់ថ្មី
            </button>
        </form>
    </div>

    <script>
        const supabaseUrl = '<%= supabaseUrl %>';
        const supabaseKey = '<%= supabaseKey %>';
        const supabaseClient = supabase.createClient(supabaseUrl, supabaseKey);

        document.getElementById('reset-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const newPassword = document.getElementById('new-password').value;
            const alertBox = document.getElementById('alert');

            const { error } = await supabaseClient.auth.updateUser({ password: newPassword });

            if (error) {
                alertBox.className = 'text-xs p-3 rounded-xl mb-4 bg-red-50 text-red-600 border border-red-200';
                alertBox.innerText = error.message;
                alertBox.classList.remove('hidden');
            } else {
                alertBox.className = 'text-xs p-3 rounded-xl mb-4 bg-emerald-50 text-emerald-600 border border-emerald-200';
                alertBox.innerText = 'ប្តូរលេខសម្ងាត់ជោគជ័យ! កំពុងបង្វែរទៅ Sign In...';
                alertBox.classList.remove('hidden');
                setTimeout(() => window.location.href = '/signin', 2000);
            }
        });
    </script>
</body>
</html>

