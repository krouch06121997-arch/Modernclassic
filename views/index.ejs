<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ប្រព័ន្ធគ្រប់គ្រងហាង - PACH KROUCH POS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans min-h-screen flex">

    <!-- Sidebar ខាងឆ្វេង -->
    <aside class="w-64 bg-slate-900 text-white min-h-screen p-4 flex flex-col justify-between hidden md:flex">
        <div>
            <!-- Shop Logo & Title -->
            <div class="flex items-center space-x-3 mb-8 px-2">
                <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-xl font-bold shadow-lg shadow-indigo-500/30">
                    <i class="fa-solid fa-shop"></i>
                </div>
                <div>
                    <h1 class="font-bold text-sm tracking-wide">PACH KROUCH</h1>
                    <p class="text-xs text-slate-400">ប្រព័ន្ធគ្រប់គ្រងហាងទំនើប</p>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="space-y-1.5">
                <a href="/" class="flex items-center space-x-3 bg-indigo-600 text-white px-4 py-3 rounded-xl font-semibold text-sm shadow-md">
                    <i class="fa-solid fa-chart-line w-5"></i>
                    <span>ផ្ទាំងគ្រប់គ្រង (Dashboard)</span>
                </a>
                <a href="#pos" class="flex items-center space-x-3 text-slate-400 hover:bg-slate-800 hover:text-white px-4 py-3 rounded-xl font-semibold text-sm transition">
                    <i class="fa-solid fa-cash-register w-5"></i>
                    <span>ផ្នែកគិតលុយ (POS)</span>
                </a>
                <a href="#products" class="flex items-center space-x-3 text-slate-400 hover:bg-slate-800 hover:text-white px-4 py-3 rounded-xl font-semibold text-sm transition">
                    <i class="fa-solid fa-boxes-packing w-5"></i>
                    <span>គ្រប់គ្រងស្តុកទំនិញ</span>
                </a>
                <a href="#reports" class="flex items-center space-x-3 text-slate-400 hover:bg-slate-800 hover:text-white px-4 py-3 rounded-xl font-semibold text-sm transition">
                    <i class="fa-solid fa-file-invoice-dollar w-5"></i>
                    <span>របាយការណ៍លក់</span>
                </a>
            </nav>
            <!-- ប្រអប់បង្ហាញ Link ហាងផ្ទាល់ខ្លួន -->
<div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 mb-6">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-bold">
            <i class="fa-solid fa-store"></i>
        </div>
        <div>
            <h4 class="text-xs font-bold text-indigo-950">Link ហាងអនឡាញរបស់អ្នក</h4>
            <p class="text-[11px] text-indigo-700 font-mono" id="storeUrl">
                <%= user ? `https://modernclassic-1.onrender.com/store/${user.id}` : '' %>
            </p>
        </div>
    </div>
    
    <a href="/store/<%= user.id %>" target="_blank" 
       class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-4 py-2 rounded-xl transition flex items-center gap-2 shadow-sm whitespace-nowrap">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <span>មើលហាងរបស់អ្នក</span>
    </a>
</div>

        </div>

        <!-- User Info & Logout -->
        <div class="border-t border-slate-800 pt-4">
            <div class="flex items-center space-x-3 px-2 mb-3">
                <div class="w-8 h-8 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div class="truncate">
                    <p class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">អ្នកគ្រប់គ្រង</p>
                    <p class="text-xs font-bold text-slate-200 truncate"><%= user ? user.email : '' %></p>
                </div>
            </div>
            <a href="/logout" class="flex items-center space-x-2 text-xs text-red-400 hover:bg-red-500/10 p-2.5 rounded-xl font-bold transition">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>ចាកចេញពីប្រព័ន្ធ</span>
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col min-h-screen">
        <!-- Top Navbar -->
        <header class="bg-white border-b px-6 py-4 flex justify-between items-center shadow-sm">
            <div>
                <h2 class="text-lg font-bold text-gray-800">ផ្ទាំងគ្រប់គ្រងអាជីវកម្ម</h2>
                <p class="text-xs text-gray-500">មើលស្ថិតិការលក់ និងស្ថានភាពស្តុកទំនិញទូទៅ</p>
            </div>
            <div class="flex items-center space-x-3 md:hidden">
                <span class="text-xs font-bold text-gray-600"><%= user ? user.email : '' %></span>
                <a href="/logout" class="text-xs text-red-600 font-bold bg-red-50 px-3 py-1.5 rounded-lg">ចាកចេញ</a>
            </div>
        </header>

        <!-- Dashboard Content -->
        <div class="p-6 space-y-6 flex-1">
            <!-- Top Metric Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 font-semibold mb-1">ចំណូលសរុបថ្ងៃនេះ</p>
                        <p class="text-2xl font-bold text-emerald-600">$1,280.00</p>
                    </div>
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-xl">
                        <i class="fa-solid fa-circle-dollar-to-slot"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 font-semibold mb-1">ការលក់សរុប (Orders)</p>
                        <p class="text-2xl font-bold text-gray-800">84 ប្រតិបត្តិការ</p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center text-xl">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 font-semibold mb-1">ទំនិញក្នុងស្តុកសរុប</p>
                        <p class="text-2xl font-bold text-gray-800">456 មុខ</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-xl">
                        <i class="fa-solid fa-boxes-stacked"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-500 font-semibold mb-1">ទំនិញជិតអស់ពីស្តុក</p>
                        <p class="text-2xl font-bold text-amber-600">5 មុខ</p>
                    </div>
                    <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center text-xl">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                </div>
            </div>

            <!-- Inventory Management Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-5 border-b flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <h3 class="font-bold text-gray-800 text-base">បញ្ជីគ្រប់គ្រងស្តុកទំនិញ</h3>
                        <p class="text-xs text-gray-500">ទិន្នន័យទំនិញ និងចំនួនដែលនៅសល់ជាក់ស្តែង</p>
                    </div>
                    <button id="openModalBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl transition flex items-center gap-2 shadow-md shadow-indigo-500/20">
                        <i class="fa-solid fa-plus"></i>
                        <span>បន្ថែមទំនិញថ្មី</span>
                    </button>
                </div>


                    <!-- Modal សម្រាប់បញ្ចូលទំនិញថ្មី -->
    <div id="productModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden z-50 p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-gray-100">
            <div class="flex justify-between items-center mb-6 border-b pb-3">
                <h3 class="font-bold text-gray-800 text-base">បន្ថែមទំនិញថ្មីចូលស្តុក</h3>
                <button id="closeModalBtn" class="text-gray-400 hover:text-gray-600 font-bold text-xl">&times;</button>
            </div>

            <form action="/add-product" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">barcode / SKU</label>
                    <input type="text" name="barcode" placeholder="ឧទាហរណ៍៖ 8850123456" 
                           class="w-full px-4 py-2 bg-gray-50 border rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">ឈ្មោះទំនិញ <span class="text-red-500">*</span></label>
                    <input type="text" name="name" required placeholder="ឧទាហរណ៍៖ អាវយឺត Cotton" 
                           class="w-full px-4 py-2 bg-gray-50 border rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">តម្លៃ ($) <span class="text-red-500">*</span></label>
                        <input type="number" step="0.01" name="price" required placeholder="0.00" 
                               class="w-full px-4 py-2 bg-gray-50 border rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">ចំនួនស្តុក <span class="text-red-500">*</span></label>
                        <input type="number" name="current_stock" required placeholder="0" 
                               class="w-full px-4 py-2 bg-gray-50 border rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">ខ្នាត (Unit)</label>
                    <input type="text" name="unit" placeholder="ឧទាហរណ៍៖ កញ្ចប់, អាវ, ដប" value="កញ្ចប់" 
                           class="w-full px-4 py-2 bg-gray-50 border rounded-xl text-xs focus:outline-none focus:border-indigo-500">
                </div>

                <div class="flex space-x-3 pt-4 border-t mt-6">
                    <button type="button" id="cancelBtn" class="w-1/2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 rounded-xl text-xs transition">
                        បោះបង់
                    </button>
                    <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 rounded-xl text-xs transition shadow-md shadow-indigo-500/20">
                        រក្សាទុកទំនិញ
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript សម្រាប់បើក/បិទ Modal -->
    <script>
        const modal = document.getElementById('productModal');
        const openBtn = document.getElementById('openModalBtn');
        const closeBtn = document.getElementById('closeModalBtn');
        const cancelBtn = document.getElementById('cancelBtn');

        if(openBtn) {
            openBtn.addEventListener('click', () => modal.classList.remove('hidden'));
        }
        if(closeBtn) {
            closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
        }
        if(cancelBtn) {
            cancelBtn.addEventListener('click', () => modal.classList.add('hidden'));
        }
    </script>



                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-gray-600">
                        <thead class="bg-slate-50 border-b text-gray-700 font-bold uppercase tracking-wider">
                            <tr>
                                <th class="p-4">កូដទំនិញ (SKU)</th>
                                <th class="p-4">ឈ្មោះទំនិញ</th>
                                <th class="p-4">ប្រភេទ (Category)</th>
                                <th class="p-4">តម្លៃលក់</th>
                                <th class="p-4">ស្តុកនៅសល់</th>
                                <th class="p-4">ស្ថានភាព</th>
                                <th class="p-4 text-center">សកម្មភាព</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
    <% if (products.length === 0) { %>
        <tr>
            <td colspan="6" class="p-4 text-center text-gray-400">មិនទាន់មានទំនិញក្នុងស្តុកនៅឡើយទេ</td>
        </tr>
    <% } else { %>
        <% products.forEach(item => { %>
            <tr class="hover:bg-gray-50/80 transition">
                <td class="p-4 font-mono text-gray-500"><%= item.barcode || 'N/A' %></td>
                <td class="p-4 font-bold text-gray-800"><%= item.name %></td>
                <td class="p-4 text-emerald-600 font-bold">$<%= Number(item.price).toFixed(2) %></td>
                <td class="p-4 font-semibold"><%= item.current_stock %> <%= item.unit %></td>
                <td class="p-4">
                    <% if (item.current_stock > (item.min_alert_limit || 5)) { %>
                        <span class="bg-emerald-100 text-emerald-700 px-2.5 py-1 rounded-full font-bold text-[10px]">មានស្តុក</span>
                    <% } else { %>
                        <span class="bg-amber-100 text-amber-700 px-2.5 py-1 rounded-full font-bold text-[10px]">ជិតអស់</span>
                    <% } %>
                </td>
                <td class="p-4 text-center space-x-2">
                    <button class="text-blue-600 hover:text-blue-800 font-bold"><i class="fa-solid fa-pen-to-square"></i></button>
                    <button class="text-red-600 hover:text-red-800 font-bold"><i class="fa-solid fa-trash"></i></button>
                </td>
            </tr>
        <% }) %>
    <% } %>
</tbody>

                    </table>
                </div>
            </div>
        </div>


    </main>
</body>
</html>

