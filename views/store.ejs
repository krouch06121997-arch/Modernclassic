<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= shop.name %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 font-sans min-h-screen pb-20">

    <!-- Header ខាងលើ -->
    <header class="bg-white border-b px-6 py-4 flex justify-between items-center sticky top-0 z-30 shadow-sm">
        <h1 class="font-bold text-gray-800 text-base flex items-center gap-2">
            <i class="fa-solid fa-shop text-indigo-600"></i>
            <span><%= shop.name %></span>
        </h1>
        
        <!-- ប៊ូតុងកន្ត្រកទំនិញ -->
        <button id="openCartBtn" class="relative bg-indigo-50 hover:bg-indigo-100 text-indigo-600 p-2.5 rounded-xl transition">
            <i class="fa-solid fa-cart-shopping text-lg"></i>
            <span id="cartCount" class="absolute -top-1.5 -right-1.5 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full hidden">0</span>
        </button>
    </header>

    <!-- បញ្ជីទំនិញ (Products Grid) -->
    <main class="p-6 max-w-5xl mx-auto">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            <% if (products.length === 0) { %>
                <div class="col-span-full text-center py-12 text-gray-400">
                    <p>មិនទាន់មានទំនិញសម្រាប់លក់នៅឡើយទេ</p>
                </div>
            <% } else { %>
                <% products.forEach(item => { %>
                    <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm flex flex-col justify-between hover:shadow-md transition">
                        <div>
                            <div class="w-full h-32 bg-gray-100 rounded-xl mb-3 flex items-center justify-center text-gray-300">
                                <i class="fa-solid fa-box text-3xl"></i>
                            </div>
                            <h3 class="font-bold text-gray-800 text-sm truncate"><%= item.name %></h3>
                            <p class="text-[11px] text-gray-400 mb-2">ស្តុកនៅសល់: <%= item.current_stock || item.stock || 0 %></p>
                        </div>
                        <div class="flex items-center justify-between pt-2 border-t border-gray-50">
                            <span class="text-emerald-600 font-bold text-sm">$<%= Number(item.price).toFixed(2) %></span>
                            <button onclick="addToCart('<%= item.id %>', '<%= item.name %>', <%= item.price %>)" 
                                    class="w-8 h-8 bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white rounded-xl flex items-center justify-center transition font-bold">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>

    <!-- Slide-over Cart Panel (ផ្ទាំងកន្ត្រកទំនិញ) -->
    <div id="cartModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex justify-end hidden">
        <div class="bg-white w-full max-w-md h-full shadow-2xl flex flex-col justify-between">
            <div class="p-5 border-b flex justify-between items-center">
                <h3 class="font-bold text-gray-800 text-base flex items-center gap-2">
                    <i class="fa-solid fa-cart-shopping text-indigo-600"></i>
                    <span>កន្ត្រកទំនិញរបស់អ្នក</span>
                </h3>
                <button id="closeCartBtn" class="text-gray-400 hover:text-gray-600 font-bold text-xl">&times;</button>
            </div>

            <!-- បញ្ជីទំនិញក្នុង Cart -->
            <div id="cartItems" class="p-5 overflow-y-auto flex-1 space-y-3">
                <!-- នឹងបង្ហាញទំនិញតាម JavaScript -->
            </div>

            <!-- សរុបលុយ និងប៊ូតុង Checkout -->
            <div class="p-5 border-t bg-gray-50 space-y-4">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-gray-500">តម្លៃសរុប (Total)</span>
                    <span id="cartTotal" class="text-xl font-bold text-emerald-600">$0.00</span>
                </div>
                <button onclick="checkout()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl text-xs transition shadow-lg shadow-indigo-500/30">
                    បញ្ជូនការកម្មង់ទិញ
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript សម្រាប់គ្រប់គ្រង Cart -->
    <script>
        let cart = [];

        function addToCart(id, name, price) {
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ id, name, price, qty: 1 });
            }
            updateCartUI();
        }

        function updateCartUI() {
            const cartCount = document.getElementById('cartCount');
            const cartItems = document.getElementById('cartItems');
            const cartTotal = document.getElementById('cartTotal');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            cartCount.innerText = totalQty;
            cartCount.classList.toggle('hidden', totalQty === 0);
            cartTotal.innerText = `$${totalPrice.toFixed(2)}`;

            if (cart.length === 0) {
                cartItems.innerHTML = `<p class="text-center text-xs text-gray-400 py-8">គ្មានទំនិញក្នុងកន្ត្រកទេ</p>`;
            } else {
                cartItems.innerHTML = cart.map(item => `
                    <div class="flex items-center justify-between bg-white p-3 rounded-xl border border-gray-100 shadow-sm">
                        <div>
                            <h4 class="font-bold text-xs text-gray-800">${item.name}</h4>
                            <p class="text-[11px] text-emerald-600 font-bold">$${item.price.toFixed(2)} x ${item.qty}</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="changeQty('${item.id}', -1)" class="w-6 h-6 bg-gray-100 text-gray-600 rounded-lg text-xs font-bold">-</button>
                            <span class="text-xs font-bold">${item.qty}</span>
                            <button onclick="changeQty('${item.id}', 1)" class="w-6 h-6 bg-gray-100 text-gray-600 rounded-lg text-xs font-bold">+</button>
                        </div>
                    </div>
                `).join('');
            }
        }

        function changeQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.qty += delta;
                if (item.qty <= 0) {
                    cart = cart.filter(i => i.id !== id);
                }
            }
            updateCartUI();
        }

        const modal = document.getElementById('cartModal');
        document.getElementById('openCartBtn').onclick = () => modal.classList.remove('hidden');
        document.getElementById('closeCartBtn').onclick = () => modal.classList.add('hidden');

        function checkout() {
            if (cart.length === 0) {
                alert('សូមបន្ថែមទំនិញចូលកន្ត្រកជាមុនសិន!');
                return;
            }
            alert('ការកម្មង់ទិញជោគជ័យ! សូមអរគុណ។');
            cart = [];
            updateCartUI();
            modal.classList.add('hidden');
        }
    </script>
</body>
</html>

